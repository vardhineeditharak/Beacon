generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String               @id @default(uuid())
  email         String               @unique
  passwordHash  String
  name          String
  organizations Organization[]       @relation("OrgOwner")
  memberships   OrganizationMember[]
  createdAt     DateTime             @default(now())
}

model Organization {
  id          String               @id @default(uuid())
  slug        String               @unique
  name        String
  ownerId     String
  owner       User                 @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     OrganizationMember[]
  monitors    Monitor[]
  alerts      AlertContact[]
  createdAt   DateTime             @default(now())
}

model OrganizationMember {
  id           String       @id @default(uuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         String       @default("MEMBER")
  createdAt    DateTime     @default(now())

  @@unique([orgId, userId])
}

enum MonitorType {
  HTTP
  PING
  TCP
  KEYWORD
  HEARTBEAT
}

enum MonitorStatus {
  UP
  DOWN
  PAUSED
  DEGRADED
}

enum IncidentStatus {
  DOWN
  RESOLVED
}

enum PingStatus {
  UP
  DOWN
}

model Monitor {
  id              String        @id @default(uuid())
  orgId           String
  organization    Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name            String
  type            MonitorType
  target          String        // URL, IP, Port mapping, or slug for HEARTBEAT
  keyword         String?       // For Keyword monitors
  interval        Int           // In minutes: 1, 5, 15, 30, 60
  timeoutMs       Int           @default(30000)
  status          MonitorStatus @default(UP)
  lastHeartbeatAt DateTime?
  nextCheckAt     DateTime      @default(now())
  lastCheckedAt   DateTime?
  
  incidents       Incident[]
  pingResults     PingResult[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([orgId])
  @@index([status, nextCheckAt])
}

model AlertContact {
  id            String       @id @default(uuid())
  orgId         String
  organization  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  type          String       // EMAIL, WEBHOOK, SLACK
  destination   String       // Email address or Webhook URL
  active        Boolean      @default(true)
}

model Incident {
  id          String         @id @default(uuid())
  monitorId   String
  monitor     Monitor        @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  status      IncidentStatus @default(DOWN)
  errorCause  String?
  startedAt   DateTime       @default(now())
  resolvedAt  DateTime?
}

model PingResult {
  id             String     @id @default(uuid())
  monitorId      String
  monitor        Monitor    @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  timestamp      DateTime   @default(now())
  status         PingStatus
  responseTimeMs Int
  httpStatusCode Int?
  errorMessage   String?
  
  @@index([monitorId, timestamp(sort: Desc)])
}

model PingRollup {
  id            String   @id @default(uuid())
  monitorId     String
  periodStart   DateTime
  totalChecks   Int
  upChecks      Int
  avgResponseMs Int
  createdAt     DateTime @default(now())

  @@index([monitorId, periodStart(sort: Desc)])
}
