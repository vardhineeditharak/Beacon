# Database connection (Serverless Neon PostgreSQL or local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/beacon?schema=public"

# Redis connection for optional local BullMQ worker/scheduler daemons
REDIS_URL="redis://127.0.0.1:6379"

# Iron-session encryption key (min 32 characters, generate with: openssl rand -base64 32)
SESSION_PASSWORD="beacon-session-super-secret-key-at-least-32-chars-long"

# Secret token protecting serverless cron endpoints (/api/cron/check)
CRON_SECRET="beacon-cron-secret-change-in-production"

# Public application URL for absolute redirects and CSRF Origin protection
NEXT_PUBLIC_APP_URL="http://localhost:3000"
